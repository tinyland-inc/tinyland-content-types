{
  "name": "@tummycrypt/tinyland-content-types",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "description": "Shared content type definitions for content management and ActivityPub federation",
  "type": "module",
  "license": "(Zlib AND LicenseRef-Tinyland-Proprietary)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./visibility": {
      "types": "./dist/visibility/index.d.ts",
      "import": "./dist/visibility/index.js"
    },
    "./activitypub": {
      "types": "./dist/activitypub/index.d.ts",
      "import": "./dist/activitypub/index.js"
    },
    "./scheduling": {
      "types": "./dist/scheduling/index.d.ts",
      "import": "./dist/scheduling/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.2",
    "publint": "^0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/xoxd-ai/tinyland-content-types",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-content-types/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-content-types.git"
  }
}
